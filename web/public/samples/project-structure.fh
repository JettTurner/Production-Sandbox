#--- Templates ---
@template EVENT_TEMP
	Event
	# Project Lifecycle Events
		project_created.event.py
		project_started.event.py
		project_paused.event.py
		project_completed.event.py
		project_archived.event.py
		project_deleted.event.py

	# Task Lifecycle Events
		task_created.event.py
		task_assigned.event.py
		task_unassigned.event.py
		task_updated.event.py
		task_completed.event.py
		task_deleted.event.py

	# Phase Events
		phase_started.event.py
		phase_paused.event.py
		phase_completed.event.py
		phase_skipped.event.py
		phase_changed.event.py

	# User / Role Events
		user_created.event.py
		user_updated.event.py
		user_deleted.event.py
		user_role_changed.event.py
		user_role_removed.event.py

	# Notification / System Events
		notification_sent.event.py
		notification_failed.event.py
		cache_invalidated.event.py
		cache_refreshed.event.py
		job_scheduled.event.py
		job_completed.event.py

	# Optional / Collaboration Events
		project_template_applied.event.py
		task_comment_added.event.py
		attachment_uploaded.event.py
		tag_added.event.py
		tag_removed.event.py

